# Log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# PostgreSQL
POSTGRES_DB=motovoice
POSTGRES_USER=motovoice
# Create a secret with: openssl rand -hex 32
POSTGRES_PASSWORD=your_postgres_secret

# Create a secret with: openssl rand -hex 64
JWT_SECRET=your_jwt_secret

# Optional: require a shared password for creating channels. Clients must send
# it via the "X-Server-Password" header. Joining a channel needs no password.
# Leave empty/unset to disable.
SERVER_PASSWORD=

# Optional: private token for the /api/stats endpoints (e.g. for a Grafana
# dashboard). Clients must send it via the "X-Stats-Token" header.
# The stats endpoints are disabled entirely unless this is set.
# Create a secret with: openssl rand -hex 32
STATS_TOKEN=

# Optional: public base URL of this API (e.g. https://api.your-domain.com),
# embedded in invite links so the app knows which server to join.
# If empty, it is derived from the request (Host + X-Forwarded-Proto).
PUBLIC_URL=

# You domain for livekit
LIVEKIT_URL=wss://livekit.your-domain.com
LIVEKIT_API_KEY=motovoice_key
# Create a secret with: openssl rand -hex 32
LIVEKIT_API_SECRET=your_livekit_secret
