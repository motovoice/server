{
  "name": "motovoice-backend",
  "version": "1.0.0",
  "description": "MotoVoice Backend API",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.4",
    "@fastify/swagger-ui": "^6.1.4",
    "dotenv": "^17.4.0",
    "fastify": "^5.12.8",
    "livekit-server-sdk": "^2.19.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.4.5",
    "vitest": "^5.1.0"
  }
}
